<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        Szallasfoglalas
    </title>
</head>

<body>
    <main class="container py-4">
        <h1 class="mb-4">Jelenleg ennyi foglalás van: <%= foglalasok.length %></h1>

        <form method="POST" class="card card-body mb-4">
            <div class="mb-3">
                <label for="inputName" class="form-label">Név</label>
                <input type="text" class="form-control" id="inputName" name="name"
                    value="<%= typeof bevittAdatok !== 'undefined' && bevittAdatok.name ? bevittAdatok.name : '' %>" placeholder="Add meg a neved">
            </div>
            <div class="mb-3">
                <label for="inputEmail" class="form-label">Email</label>
                <input type="text" class="form-control" id="inputEmail" name="email"
                    value="<%= typeof bevittAdatok !== 'undefined' && bevittAdatok.email ? bevittAdatok.email : '' %>" placeholder="Add meg az emailed">
            </div>
            <div class="mb-3">
                <label for="inputDate" class="form-label">Kezdő dátum</label>
                <input type="date" class="form-control" id="inputDate" name="startDate"
                    value="<%= typeof bevittAdatok !== 'undefined' && bevittAdatok.startDate ? bevittAdatok.startDate : '' %>" placeholder="Add meg a dátumot">
            </div>
            <div class="mb-3">
                <label for="inputGuests" class="form-label">Hányan lesztek</label>
                <input type="number" class="form-control" id="inputGuests" name="guests"
                    value="<%= typeof bevittAdatok !== 'undefined' && bevittAdatok.guests ? bevittAdatok.guests : '' %>" min="1" max="10" placeholder="1 és 10 között">
            </div>
            <button type="submit" class="btn btn-primary">Submit</button>
        </form>

        <% if (typeof felvetel !== 'undefined' && felvetel) { %>
            <ul id="output" class="list-group">
                <li class="list-group-item <%= felvetel.success ? 'text-success' : 'text-danger' %>">
                    <%= felvetel.message %>
                </li>
            </ul>
        <% } else { %>
            <ul id="output" class="list-group"></ul>
        <% } %>
    </main>
</body>

</html>